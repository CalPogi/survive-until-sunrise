--!strict
local Harness = require("./Harness")
local Validate = require("../src/shared/Validate")

return function(t: Harness.T)
	t.test("isBoolean accepts only booleans", function()
		t.ok(Validate.isBoolean(true))
		t.ok(Validate.isBoolean(false))
		t.notOk(Validate.isBoolean(nil))
		t.notOk(Validate.isBoolean(0))
		t.notOk(Validate.isBoolean("true"))
	end)

	t.test("isFiniteNumber rejects NaN, infinity and non-numbers", function()
		t.ok(Validate.isFiniteNumber(0))
		t.ok(Validate.isFiniteNumber(-12.5))
		t.notOk(Validate.isFiniteNumber(0 / 0))
		t.notOk(Validate.isFiniteNumber(math.huge))
		t.notOk(Validate.isFiniteNumber(-math.huge))
		t.notOk(Validate.isFiniteNumber("5"))
		t.notOk(Validate.isFiniteNumber(nil))
	end)

	t.test("numberBetween is inclusive and rejects bad input", function()
		local check = Validate.numberBetween(0, 10)
		t.ok(check(0))
		t.ok(check(10))
		t.ok(check(5.5))
		t.notOk(check(-0.001))
		t.notOk(check(10.001))
		t.notOk(check(0 / 0))
		t.notOk(check(math.huge))
		t.notOk(check("5"))
	end)

	t.test("integerBetween rejects fractions and out-of-range values", function()
		local check = Validate.integerBetween(-5, 5)
		t.ok(check(-5))
		t.ok(check(0))
		t.ok(check(5))
		t.ok(check(-3))
		t.notOk(check(1.5))
		t.notOk(check(-5.5))
		t.notOk(check(6))
		t.notOk(check(-6))
		t.notOk(check(0 / 0))
		t.notOk(check(math.huge))
		t.notOk(check("1"))
	end)

	t.test("string enforces length bounds", function()
		local check = Validate.string(5, 2)
		t.ok(check("ab"))
		t.ok(check("abcde"))
		t.notOk(check("a"))
		t.notOk(check("abcdef"))
		t.notOk(check(12))
		t.ok(Validate.string(3)(""))
	end)

	t.test("identifier allows safe characters only", function()
		local check = Validate.identifier(12)
		t.ok(check("iron_sword-2"))
		t.ok(check("A"))
		t.notOk(check(""))
		t.notOk(check("has space"))
		t.notOk(check("semi;colon"))
		t.notOk(check("quote'"))
		t.notOk(check("new\nline"))
		t.notOk(check("this_is_too_long"))
		t.notOk(check(5))
		t.ok(Validate.identifier()(string.rep("a", 64)))
		t.notOk(Validate.identifier()(string.rep("a", 65)))
	end)

	t.test("oneOf matches exact allowed strings", function()
		local check = Validate.oneOf({ "Sword", "Bow" })
		t.ok(check("Sword"))
		t.ok(check("Bow"))
		t.notOk(check("sword"))
		t.notOk(check("Axe"))
		t.notOk(check(1))
		t.notOk(check(nil))
	end)

	t.test("arrayOf requires a real array and checks every item", function()
		local check = Validate.arrayOf(Validate.integerBetween(1, 9), 3)
		t.ok(check({}))
		t.ok(check({ 1, 2, 3 }))
		t.notOk(check({ 1, 2, 3, 4 }), "too long")
		t.notOk(check({ 1, 20 }), "item out of range")
		t.notOk(check({ 1, "2" }), "item wrong type")
		t.notOk(check({ a = 1 }), "dictionary")
		t.notOk(check({ [1] = 1, [3] = 3 }), "holes")
		-- selene: allow(mixed_table)
		t.notOk(check({ 1, 2, x = 3 }), "extra string key")
		t.notOk(check("123"))
		t.notOk(check(nil))
	end)

	t.test("args requires the exact argument count", function()
		local checks = { Validate.identifier(8), Validate.integerBetween(1, 10) }
		t.ok(Validate.args(checks, "sword", 3))
		t.notOk(Validate.args(checks, "sword"), "too few")
		t.notOk(Validate.args(checks, "sword", 3, 4), "too many")
		t.notOk(Validate.args(checks), "none")
		t.ok(Validate.args({}), "no checks, no args")
		t.notOk(Validate.args({}, 1), "no checks but an arg")
	end)

	t.test("args checks each argument against its own check", function()
		local checks = { Validate.identifier(8), Validate.integerBetween(1, 10) }
		t.notOk(Validate.args(checks, 3, "sword"), "swapped types")
		t.notOk(Validate.args(checks, "sword", 11), "out of range")
		t.notOk(Validate.args(checks, "sword", nil), "nil argument")
		t.notOk(Validate.args(checks, nil, 3), "nil first argument")
	end)
end
