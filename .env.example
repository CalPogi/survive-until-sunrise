# Copy to .env (gitignored) and fill in. Never commit real keys.
# Freesound: free account, then https://freesound.org/apiv2/apply
FREESOUND_API_KEY=
# Roblox: create.roblox.com/dashboard/credentials -> API key with "assets" read + write
ROBLOX_API_KEY=
# The number in your profile URL: roblox.com/users/<this>/profile
ROBLOX_USER_ID=
