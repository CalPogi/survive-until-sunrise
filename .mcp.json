{
  "mcpServers": {
    "Roblox_Studio": {
      "type": "stdio",
      "command": "cmd.exe",
      "args": [
        "/c",
        "cd /d %LOCALAPPDATA%\\Roblox && .\\mcp.bat"
      ],
      "env": {}
    },
    "blender": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-for-blender@2.2.6"
      ],
      "env": {
        "DISABLE_TELEMETRY": "true"
      }
    }
  }
}